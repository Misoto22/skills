# Measured on the Python that actually ships. Everything under scripts/ is
# exercised through subprocess by the contract tests, where a coverage number
# would describe the harness rather than the code.

[run]
source = plugins
branch = true

[report]
# The floor is a ratchet, not a target: it sits just under what the suite
# already reaches, so a large untested addition fails and small movement does
# not. Raise it when the real number rises; never lower it to make a run pass.
fail_under = 75
show_missing = true
