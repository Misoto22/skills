{
  "pins": [
    {
      "id": "claude-code",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.295",
      "documented_in": []
    },
    {
      "id": "codex",
      "package": "@openai/codex",
      "version": "0.162.0",
      "documented_in": []
    },
    {
      "id": "skills",
      "package": "skills",
      "version": "1.7.1",
      "documented_in": [
        "README.md",
        "README.zh-CN.md"
      ]
    },
    {
      "id": "ruff",
      "package": "ruff",
      "version": "0.16.10",
      "match": "RUFF_VERSION: \"{version}\"",
      "documented_in": [
        ".github/workflows/validate.yml"
      ]
    },
    {
      "id": "uv",
      "package": "uv",
      "version": "0.12.24",
      "match": "UV_VERSION: \"{version}\"",
      "documented_in": [
        ".github/workflows/evals.yml",
        ".github/workflows/release.yml",
        ".github/workflows/validate.yml"
      ]
    },
    {
      "id": "coverage",
      "package": "coverage",
      "version": "7.16.2",
      "spec": "{package}=={version}",
      "spec_latest": "{package}",
      "documented_in": []
    },
    {
      "id": "openai",
      "package": "openai",
      "version": "3.26.1",
      "spec": "{package}=={version}",
      "spec_latest": "{package}",
      "documented_in": []
    },
    {
      "id": "python",
      "package": "python",
      "version": "3.13",
      "version_pattern": "\\d+\\.\\d+",
      "match": "python-version: \"{version}\"",
      "spec": "{version}",
      "spec_latest": "{version}",
      "documented_in": [
        ".github/workflows/evals.yml",
        ".github/workflows/install.yml",
        ".github/workflows/release.yml",
        ".github/workflows/validate.yml"
      ]
    },
    {
      "id": "node",
      "package": "node",
      "version": "22",
      "version_pattern": "\\d+",
      "match": "node-version: {version}",
      "spec": "{version}",
      "spec_latest": "{version}",
      "documented_in": [
        ".github/workflows/install.yml",
        ".github/workflows/validate.yml"
      ]
    },
    {
      "id": "evals-model",
      "package": "deepseek-default",
      "version": "deepseek-default",
      "version_pattern": "[a-z][a-z0-9.-]*",
      "match": "ROUTER_MODEL = \"{version}\"",
      "spec": "{version}",
      "spec_latest": "{version}",
      "documented_in": [
        "scripts/run-evals.py"
      ]
    }
  ],
  "scan": {
    "exclude": [
      ".claude",
      ".git",
      "CHANGELOG.md",
      "deprecated",
      "dist",
      "drafts"
    ]
  }
}
