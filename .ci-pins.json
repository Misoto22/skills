{
  "pins": [
    {
      "id": "claude-code",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.220",
      "documented_in": []
    },
    {
      "id": "codex",
      "package": "@openai/codex",
      "version": "0.147.0",
      "documented_in": []
    },
    {
      "id": "skills",
      "package": "skills",
      "version": "1.5.22",
      "documented_in": [
        "README.md",
        "README.zh-CN.md"
      ]
    },
    {
      "id": "ruff",
      "package": "ruff",
      "version": "0.14.6",
      "match": "RUFF_VERSION: \"{version}\"",
      "documented_in": [
        ".github/workflows/validate.yml"
      ]
    },
    {
      "id": "coverage",
      "package": "coverage",
      "version": "7.15.3",
      "spec": "{package}=={version}",
      "spec_latest": "{package}",
      "documented_in": []
    },
    {
      "id": "anthropic",
      "package": "anthropic",
      "version": "0.120.2",
      "spec": "{package}=={version}",
      "spec_latest": "{package}",
      "documented_in": []
    }
  ],
  "scan": {
    "exclude": [
      ".claude",
      ".git",
      "CHANGELOG.md",
      "deprecated",
      "dist",
      "drafts"
    ]
  }
}
